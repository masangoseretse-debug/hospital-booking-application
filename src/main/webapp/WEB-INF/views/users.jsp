<%@ page import="java.util.List,za.ac.cput.hospital.model.User" %><%@ include file="includes/header.jsp" %><section class="page-heading"><div><h1>User management</h1><p>Search users and activate or deactivate accounts.</p></div></section><section class="card"><form class="filters"><input name="search" value="<%=request.getParameter("search")==null?"":request.getParameter("search")%>" placeholder="Search name or email"><button class="btn secondary">Search</button></form><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody><%for(User u:(List<User>)request.getAttribute("users")){%><tr><td><%=u.fullName()%></td><td><%=u.email()%></td><td><%=u.role()%></td><td><span class="badge <%=u.active()?"completed":"cancelled"%>"><%=u.active()?"ACTIVE":"INACTIVE"%></span></td><td><form method="post"><input type="hidden" name="id" value="<%=u.id()%>"><input type="hidden" name="active" value="<%=!u.active()%>"><button class="link-button"><%=u.active()?"Deactivate":"Activate"%></button></form></td></tr><%}%></tbody></table></div></section><%@ include file="includes/footer.jsp" %>
