<%@ page import="java.util.List,java.util.Map,za.ac.cput.hospital.model.Appointment" %><%@ include file="includes/header.jsp" %><%List<Appointment> appointments=(List<Appointment>)request.getAttribute("appointments");List<Map<String,Object>> doctors=(List<Map<String,Object>>)request.getAttribute("doctors");%>
<section class="page-heading"><div><h1>Appointments</h1><p>Create, search, update and delete appointment records.</p></div><%if(currentUser.role().equals("PATIENT")){%><button class="btn primary" data-open="create-dialog">New appointment</button><%}%></section>
<section class="card"><form class="filters" method="get"><input name="search" value="<%=request.getParameter("search")==null?"":request.getParameter("search")%>" placeholder="Search patient, doctor or reason"><select name="status"><option value="ALL">All statuses</option><%for(String st:new String[]{"PENDING","CONFIRMED","COMPLETED","CANCELLED"}){%><option <%=st.equals(request.getParameter("status"))?"selected":""%>><%=st%></option><%}%></select><button class="btn secondary">Search</button><a class="btn ghost" href="<%=ctx%>/appointments/">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Department</th><th>Date and time</th><th>Status</th><th>Actions</th></tr></thead><tbody><%if(appointments.isEmpty()){%><tr><td colspan="6" class="empty">No appointments match the selected filters.</td></tr><%}for(Appointment a:appointments){%><tr><td><%=a.patientName()%><small><%=a.reason()==null?"":a.reason()%></small></td><td><%=a.doctorName()%></td><td><%=a.department()%></td><td><%=a.date()%><br><%=a.time()%></td><td><span class="badge <%=a.status().toLowerCase()%>"><%=a.status()%></span></td><td class="actions"><%if(!currentUser.role().equals("PATIENT")){%><button class="link-button" data-edit data-id="<%=a.id()%>" data-date="<%=a.date()%>" data-time="<%=a.time()%>" data-status="<%=a.status()%>" data-reason="<%=a.reason()==null?"":a.reason().replace("\"","&quot;")%>">Edit</button><%}%><%if(currentUser.role().equals("PATIENT")||currentUser.role().equals("ADMIN")||currentUser.role().equals("SYSTEM_ADMIN")){%><form method="post" class="inline confirm-delete"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=a.id()%>"><button class="link-button danger">Delete</button></form><%}%></td></tr><%}%></tbody></table></div></section>
<dialog id="create-dialog"><form method="post"><input type="hidden" name="action" value="create"><div class="dialog-title"><h2>New appointment</h2><button type="button" data-close>×</button></div><label>Doctor<select name="doctorId" required><option value="">Select a doctor</option><%for(Map<String,Object>d:doctors){%><option value="<%=d.get("id")%>"><%=d.get("name")%> · <%=d.get("specialization")%></option><%}%></select></label><div class="grid two"><label>Date<input type="date" name="date" required></label><label>Time<input type="time" name="time" required></label></div><label>Reason<textarea name="reason" required></textarea></label><div class="dialog-actions"><button type="button" class="btn secondary" data-close>Cancel</button><button class="btn primary">Save appointment</button></div></form></dialog>
<dialog id="edit-dialog"><form method="post"><input type="hidden" name="action" value="update"><input type="hidden" name="id"><div class="dialog-title"><h2>Edit appointment</h2><button type="button" data-close>×</button></div><div class="grid two"><label>Date<input type="date" name="date" required></label><label>Time<input type="time" name="time" required></label></div><label>Status<select name="status"><option>PENDING</option><option>CONFIRMED</option><option>COMPLETED</option><option>CANCELLED</option></select></label><label>Reason<textarea name="reason"></textarea></label><label>Cancellation reason<textarea name="cancellationReason"></textarea></label><div class="dialog-actions"><button type="button" class="btn secondary" data-close>Cancel</button><button class="btn primary">Update</button></div></form></dialog>
<%@ include file="includes/footer.jsp" %>
