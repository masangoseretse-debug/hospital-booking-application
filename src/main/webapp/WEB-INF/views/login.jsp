<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Ubuntu Health</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body class="auth-page"><main class="auth-card"><h1>Ubuntu Health</h1><p>Sign in to manage your hospital appointments.</p><%if(request.getAttribute("error")!=null){%><div class="alert alert-error"><%=request.getAttribute("error")%></div><%}String f=(String)session.getAttribute("flash");if(f!=null){session.removeAttribute("flash");%><div class="alert alert-success"><%=f%></div><%}%><form method="post"><label>Email<input type="email" name="email" required autocomplete="email"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button class="btn primary" type="submit">Sign in</button></form><p class="muted">New patient? <a href="${pageContext.request.contextPath}/register">Create an account</a></p><details><summary>Demo accounts</summary><small>patient@ubuntuhealth.co.za / Password1<br>doctor@ubuntuhealth.co.za / Password1<br>admin@ubuntuhealth.co.za / Password1</small></details></main></body></html>
