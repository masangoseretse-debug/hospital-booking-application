<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register · Ubuntu Health</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body class="auth-page"><main class="auth-card wide"><h1>Patient registration</h1><p>Create a secure patient account.</p><%if(request.getAttribute("error")!=null){%><div class="alert alert-error"><%=request.getAttribute("error")%></div><%}%><form method="post"><div class="grid two"><label>Full name<input name="name" required></label><label>Email<input type="email" name="email" required></label><label>Phone<input name="phone" required pattern="[0-9 +()-]{10,20}"></label><label>Password<input type="password" name="password" required minlength="8"></label></div><label>Address<textarea name="address" required></textarea></label><button class="btn primary" type="submit">Register</button><a class="btn secondary" href="${pageContext.request.contextPath}/login">Back to sign in</a></form></main></body></html>
