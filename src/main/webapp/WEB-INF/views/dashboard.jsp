<%@ page import="java.util.List,za.ac.cput.hospital.model.Appointment" %><%@ include file="includes/header.jsp" %>
<section class="page-heading"><div><h1>Welcome, <%=currentUser.fullName()%></h1><p><%=currentUser.role().replace('_',' ')%> dashboard</p></div></section>
<section class="stats"><article><strong><%=request.getAttribute("total")%></strong><span>Total appointments</span></article><article><strong><%=request.getAttribute("pending")%></strong><span>Pending</span></article><article><strong><%=request.getAttribute("completed")%></strong><span>Completed</span></article></section>
<section class="card"><div class="section-title"><h2>Recent appointments</h2><a class="btn primary" href="<%=ctx%>/appointments/">Manage appointments</a></div><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Status</th></tr></thead><tbody><%for(Appointment a:(List<Appointment>)request.getAttribute("appointments")){%><tr><td><%=a.patientName()%></td><td><%=a.doctorName()%></td><td><%=a.date()%> <%=a.time()%></td><td><span class="badge <%=a.status().toLowerCase()%>"><%=a.status()%></span></td></tr><%}%></tbody></table></div></section>
<%@ include file="includes/footer.jsp" %>
