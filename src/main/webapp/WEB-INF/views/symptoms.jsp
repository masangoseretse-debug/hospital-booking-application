<%@ include file="includes/header.jsp" %><section class="page-heading"><div><h1>Symptom checker</h1><p>This tool offers guidance only and does not replace a medical diagnosis.</p></div></section><section class="card narrow"><%if(request.getAttribute("recommendation")!=null){%><div class="alert alert-success"><strong>Recommendation:</strong> <%=request.getAttribute("recommendation")%></div><%}%><form method="post"><label>Describe your symptoms<textarea name="symptoms" required minlength="5" placeholder="Example: fever, cough and sore throat"></textarea></label><label>Severity<select name="severity"><option>MILD</option><option>MODERATE</option><option>SEVERE</option></select></label><label class="check"><input type="checkbox" required> I understand that this is not a medical diagnosis.</label><button class="btn primary">Check symptoms</button></form></section><%@ include file="includes/footer.jsp" %>
